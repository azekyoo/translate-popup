{
  "manifest_version": 3,
  "name": "Translate Popup",
  "version": "1.0.0",
  "description": "Select text, click the bubble, read the translation next to it. No length limit.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }, "default_title": "Translate Popup (select text, then Alt+T)" },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Translate selected text"
    }
  }
}
